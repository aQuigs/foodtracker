{
  "name": "foodtracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p scripts/tsconfig.json && vite build",
    "postbuild": "node scripts/check-bundle-size.mjs",
    "preview": "vite preview",
    "test": "web-test-runner",
    "test:watch": "web-test-runner --watch",
    "screenshots": "node scripts/screenshot-pages.mjs",
    "build-food-source": "tsx scripts/build-food-source.ts"
  },
  "devDependencies": {
    "@esm-bundle/chai": "^4.3.4-fix.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "^26.4.1",
    "@web/dev-server-esbuild": "^2.0.0",
    "@web/test-runner": "^1.0.0",
    "@web/test-runner-playwright": "^1.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.4.0",
    "vite": "^5.2.0"
  },
  "dependencies": {
    "fzf": "^0.5.2",
    "idb": "^8.0.3"
  }
}
